{
  "description": "Inject a short efficiency policy at session start without loading full skills",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/session-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
